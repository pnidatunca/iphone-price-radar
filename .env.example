# Copy this file to .env and fill in the values. Never commit .env.
# In GitHub Actions the same names are provided as repository secrets.

# Neon PostgreSQL connection string
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DagsHub (weekly Parquet archive, later MLflow tracking): a personal token with access to all of the account's
# repositories, so it is never printed
DAGSHUB_USER_TOKEN=
